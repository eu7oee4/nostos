# Required — your own key (BYOK)
LLM_API_KEY=

# Optional
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DATA_DIR=./data
PORT=8787
# Self-host single user
USER_ID=local

# Display timezone for frozen message stamps + per-turn time anchor
# (NOT stored in user_profile.json). Needs IANA name; tzdata package on slim images.
TIMEZONE=Asia/Shanghai

# Proactive wakes (in-app "come find you"): off by default
# Set true locally, then POST /wakes {"delay_seconds":60,"note":"测试醒来"}
PROACTIVE_ENABLED=false

# 出站推送（Web Push / PWA）。VAPID 密钥对第一次用时自动生成到 DATA_DIR/vapid_private.pem，
# 不用手动配；换掉那个文件 = 换身份，所有旧订阅立刻失效。
# 这里只需要填一个**能联系到你的邮箱**：它进 VAPID 的 sub claim，推送厂商要求合法 mailto:。
# 留着默认的 example.com 现在能发出去，但那是占位域名，自托管请改成自己的。
VAPID_SUBJECT=mailto:you@example.com

# 通知标题（锁屏上显示的那个名字）
PUSH_TITLE=nostos
