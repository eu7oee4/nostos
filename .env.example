# Required — your own key (BYOK)
LLM_API_KEY=

# Optional
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DATA_DIR=./data
PORT=8787
# Self-host single user
USER_ID=local

# 一道门。留空 = 没门（tailnet 内自托管默认这样，Tailscale 本身就是门）。
# 走 cloudflared / ngrok / 公网 VPS 之前必须填一个长随机串，否则谁开链接谁烧你的 key。
# 填了之后：手机第一次打开 https://…/?token=<这个串>，之后那台设备不用再带；
# curl 用 -H 'Authorization: Bearer <这个串>'。
ACCESS_TOKEN=

# Display timezone for frozen message stamps + per-turn time anchor
# (NOT stored in user_profile.json). Needs IANA name; tzdata package on slim images.
TIMEZONE=Asia/Shanghai

# Proactive wakes (in-app "come find you"): off by default
# Set true locally, then POST /wakes {"delay_seconds":60,"note":"测试醒来"}
PROACTIVE_ENABLED=false

# 出站推送（Web Push / PWA）。VAPID 密钥对第一次用时自动生成到 DATA_DIR/vapid_private.pem，
# 不用手动配；换掉那个文件 = 换身份，所有旧订阅立刻失效。
# 这里只需要填一个**能联系到你的邮箱**：它进 VAPID 的 sub claim，推送厂商要求合法 mailto:。
# 留着默认的 example.com 现在能发出去，但那是占位域名，自托管请改成自己的。
VAPID_SUBJECT=mailto:you@example.com

# 通知标题（锁屏上显示的那个名字）
PUSH_TITLE=nostos

# 记忆检索的向量服务（docs/MIN_MEMORY.md「检索」）。留空 = 不做向量，召回只有关键词 + 新的在前。
# DeepSeek 没有 embeddings 接口。本机有 cassette 那套 ombre-ollama（bge-m3）的话：
#   宿主机跑 make run：EMBED_BASE_URL=http://127.0.0.1:11434（要先起 nostos-ollama-proxy，见 README）
#   docker compose：叠 docker-compose.ombre.yml，不用在这儿填
# 云端 OpenAI 兼容（如硅基流动）：EMBED_API_FORMAT=openai，base_url 带 /v1，模型名写全 BAAI/bge-m3
EMBED_BASE_URL=
EMBED_MODEL=bge-m3
EMBED_API_FORMAT=ollama
# EMBED_API_KEY=

# 会话段与重铸（docs/SEGMENTS.md）。默认值一般不用动。
# 软线 / 硬线按字符算；闲置阈值必须小于缓存 TTL；tail 轮数 = episode 新鲜的最大轮数。
# SEGMENT_SOFT_CHARS=6000
# SEGMENT_HARD_CHARS=20000
# SEGMENT_TAIL_TURNS=10
# SEGMENT_IDLE_MINUTES=15
# SEGMENT_CACHE_TTL_MINUTES=20
# EPISODE_MAX_CHARS=800
