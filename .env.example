# Required — your own key (BYOK)
LLM_API_KEY=

# Optional
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DATA_DIR=./data
PORT=8787
# Self-host single user
USER_ID=local

# Proactive wakes (in-app "come find you"): off by default
# Set true locally, then POST /wakes {"delay_seconds":60,"note":"测试醒来"}
PROACTIVE_ENABLED=false
